{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ags-live-report",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "account_id": "c0101f20bdb37f213ee8dac9b65d3e77",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./private-assets",
    "binding": "REPORT_ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ags-telemetry-prod",
      "database_id": "5bf63792-c57e-470b-86cb-2833779229e9"
    }
  ]
}
